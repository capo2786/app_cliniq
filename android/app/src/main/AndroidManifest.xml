<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Sin esto la app no tiene red en release.

        Flutter la declara solo en los manifiestos de debug y profile, así que
        en debug todo anda y al compilar en release se queda esperando una
        respuesta que nunca llega. Tiene que estar aquí.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Entrar con huella o rostro -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        La videoconsulta dentro de la aplicación: la sala de Jitsi en un
        WebView propio. El WebView solo puede darle la cámara y el micrófono
        a la página si la aplicación ya los tiene, así que se piden al entrar
        a la sala (permission_handler), no antes. MODIFY_AUDIO_SETTINGS lo
        necesita WebRTC dentro del WebView para el audio de la llamada.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        El escáner experimental de signos vitales usa la misma CAMERA (con el
        paquete camera): la trasera con el flash como linterna en el modo
        dedo (FlashMode.torch, sin permiso aparte) o la frontal en el modo
        rostro. El flash no es obligatorio para instalar la aplicación: un
        teléfono sin flash la instala igual y el escáner le propone el modo
        rostro.
    -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Recordatorios locales 24 h y 1 h antes de cada cita -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Adjuntos de las consultas en línea: no hace falta pedir ningún permiso.

        - La cámara se abre con la aplicación de cámara del teléfono
          (image_picker, intento IMAGE_CAPTURE). Como la videoconsulta ya
          declara android.permission.CAMERA, Android exige concederlo antes
          de abrir esa cámara: image_picker lo pide solo la primera vez.
        - La galería usa el selector de fotos del sistema y los PDF el de
          documentos: los dos entregan solo lo elegido, sin permiso de
          almacenamiento.
        - open_filex (abrir un PDF recibido con el visor del teléfono) trae
          en su manifiesto permisos de fotos, videos, audio y almacenamiento
          que aquí no se usan —los PDF se guardan en la carpeta privada de
          la aplicación— y que Google Play restringe. Se quitan.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />

    <application
        android:label="Cliniq"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!--
                Los enlaces que abren la aplicación los recibe app_links y
                los enruta la aplicación (ReceptorDeEnlaces). Con el enlace
                profundo propio de Flutter encendido, además, Flutter
                intentaría abrir «/confirmar-correo?token=…» como una ruta
                con nombre, que la aplicación no tiene.
            -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links: los enlaces de los correos de la clínica abren la
                aplicación en vez del navegador. Son las dos rutas del panel
                que arma el API (auth-mailer.service.ts):
                /confirmar-correo?token=… y /restablecer?token=…. El resto
                del panel sigue abriéndose en el navegador.

                autoVerify: Android comprueba al instalar que el dominio
                autoriza a esta aplicación, con el archivo
                https://cliniq.gcaicedo-proyectos.com/.well-known/assetlinks.json
                que sirve el panel (con la huella SHA-256 del certificado con
                que se firma la publicación; ver «Enlaces de los correos» en
                el README). Sin esa verificación, Android pregunta con qué
                abrirlos o los abre en el navegador, donde el panel hace lo
                mismo.

                El dominio es el de WEB_URL: si se compila con otro, se
                cambia aquí también (y en Runner.entitlements de iOS).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="cliniq.gcaicedo-proyectos.com" />
                <data android:path="/confirmar-correo" />
                <data android:path="/restablecer" />
            </intent-filter>

        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
            Reprograma los recordatorios de cita después de reiniciar el
            teléfono; sin este receptor los avisos pendientes se pierden con
            el apagado.
        -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

        <!--
            Sin http ni https: la aplicación no abre el navegador. El
            registro es una pantalla propia, y los enlaces externos del menú
            y de los artículos se abren en un WebView de la aplicación, como
            la videoconsulta.
        -->

        <!--
            Llamar o escribir a la clínica desde su teléfono y su correo
            (vienen de la configuración de la clínica)
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>

        <!-- Tomar la foto de un adjunto con la cámara del teléfono -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

        <!-- Abrir un PDF recibido con el visor del teléfono -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

</manifest>
