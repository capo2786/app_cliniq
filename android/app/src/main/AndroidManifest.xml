<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Sin esto la app no tiene red en release.

        Flutter la declara solo en los manifiestos de debug y profile, así que
        en debug todo anda y al compilar en release se queda esperando una
        respuesta que nunca llega. Tiene que estar aquí.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Entrar con huella o rostro -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        La videoconsulta dentro de la aplicación: la sala de Jitsi en un
        WebView propio. El WebView solo puede darle la cámara y el micrófono
        a la página si la aplicación ya los tiene, así que se piden al entrar
        a la sala (permission_handler), no antes. MODIFY_AUDIO_SETTINGS lo
        necesita WebRTC dentro del WebView para el audio de la llamada.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Recordatorios locales 24 h y 1 h antes de cada cita -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Adjuntos de las consultas en línea: no hace falta pedir ningún permiso.

        - La cámara se abre con la aplicación de cámara del teléfono
          (image_picker, intento IMAGE_CAPTURE). Como la videoconsulta ya
          declara android.permission.CAMERA, Android exige concederlo antes
          de abrir esa cámara: image_picker lo pide solo la primera vez.
        - La galería usa el selector de fotos del sistema y los PDF el de
          documentos: los dos entregan solo lo elegido, sin permiso de
          almacenamiento.
        - open_filex (abrir un PDF recibido con el visor del teléfono) trae
          en su manifiesto permisos de fotos, videos, audio y almacenamiento
          que aquí no se usan —los PDF se guardan en la carpeta privada de
          la aplicación— y que Google Play restringe. Se quitan.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />

    <application
        android:label="Cliniq"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
            Reprograma los recordatorios de cita después de reiniciar el
            teléfono; sin este receptor los avisos pendientes se pierden con
            el apagado.
        -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

        <!--
            El navegador integrado (Custom Tabs): el registro, el panel web
            y los enlaces externos del menú. La videoconsulta no: va en un
            WebView de la aplicación
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!--
            Llamar o escribir a la clínica desde su teléfono y su correo
            (vienen de la configuración de la clínica)
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>

        <!-- Tomar la foto de un adjunto con la cámara del teléfono -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

        <!-- Abrir un PDF recibido con el visor del teléfono -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

</manifest>
